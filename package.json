{
  "name": "production_app",
  "version": "1.0.0",
  "desktopName": "Production app",
  "private": true,
  "author": {
    "name": "Senzemo",
    "email": "anze.repse@senzemo.com"
  },
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build",
    "start": "next start",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "lint:check": "next lint",
    "lint:fix": "next lint --fix",
    "preview": "next build && next start",
    "typecheck": "tsc --noEmit",
    "deps": "ncu --interactive --format group",
    "postinstall": "prisma generate && electron-rebuild",
    "electron:rebuild": "electron-rebuild",
    "electron:compile": "mkdir -p dist-electron && cp electron/package.json dist-electron/package.json && tsc -p electron/tsconfig.json",
    "electron:compile:watch": "mkdir -p dist-electron && cp electron/package.json dist-electron/package.json && tsc -p electron/tsconfig.json --watch --preserveWatchOutput",
    "electron:dev": "concurrently -k \"bun run dev\" \"bun run electron:compile:watch\" \"wait-on http://localhost:3000 dist-electron/main.js && electron .\"",
    "electron:build": "bun run build && bun run electron:compile && electron-builder"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.844.0",
    "@aws-sdk/s3-presigned-post": "^3.844.0",
    "@aws-sdk/s3-request-presigner": "^3.844.0",
    "@better-auth/prisma-adapter": "^1.6.23",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^5.1.1",
    "@mui/icons-material": "^7.2.0",
    "@mui/material": "^7.3.1",
    "@mui/material-nextjs": "^7.2.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-tabs": "^1.1.12",
    "@react-pdf/renderer": "^4.3.0",
    "@remixicon/react": "^4.6.0",
    "@tanstack/react-query": "^5.83.0",
    "@tanstack/react-query-devtools": "^5.83.0",
    "@tanstack/react-query-next-experimental": "^5.83.0",
    "@types/deep-equal": "^1.0.4",
    "@types/hex2dec": "^1.1.4",
    "@types/ipp": "^2.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.18.0",
    "@types/request": "^2.48.12",
    "axios": "^1.10.0",
    "better-auth": "^1.6.23",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dedupe": "^4.0.3",
    "deep-equal": "^2.2.3",
    "dotenv": "^17.3.1",
    "framer-motion": "^12.23.5",
    "google-auth-library": "^10.9.1",
    "googleapis": "^152.0.0",
    "immer": "^10.1.1",
    "ipp": "^2.0.1",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.525.0",
    "next": "^15.5.20",
    "node-fetch": "^3.3.2",
    "pg": "^8.20.0",
    "prisma": "^7.8.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.60.0",
    "recharts": "^3.1.0",
    "request": "^2.88.2",
    "resend": "^4.6.0",
    "serial": "^0.0.9",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.3.1",
    "uuid": "^11.1.0",
    "web-serial-api": "^1.1.4",
    "web-serial-polyfill": "^1.0.15",
    "zod": "^4.0.5",
    "zod-key-parser": "^1.5.5",
    "zustand": "^5.0.6"
  },
  "overrides": {
    "google-auth-library": "10.9.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/dom-serial": "^1.0.6",
    "@types/node": "^24",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19",
    "@types/w3c-web-serial": "^1.0.8",
    "concurrently": "^10.0.3",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "electron-rebuild": "^3.2.9",
    "eslint": "^9",
    "eslint-config-next": "15.3.5",
    "eslint-config-prettier": "^10.1.5",
    "npm-check-updates": "^18.0.1",
    "postcss": "^8",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4.1.11",
    "typescript": "^6",
    "typescript-eslint": "^8.36.0",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.senzemo.production_app",
    "productName": "Production app",
    "publish": null,
    "asar": false,
    "files": [
      "dist-electron/**/*",
      "public/**/*",
      "node_modules/**/*",
      "package.json",
      ".env"
    ],
    "extraResources": [
      {
        "from": ".next",
        "to": "app/.next"
      }
    ],
    "directories": {
      "buildResources": "assets"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    }
  }
}
